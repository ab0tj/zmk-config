#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "dabao_trackpoint.dtsi"
#include "dabao-layouts.dtsi"

/* The physical layout carries the Studio-visible key geometry and reuses the
 * matrix transform, which stays defined in &{/} below. */
&dabao_physical_layout {
    transform = <&default_transform>;
};

&{/} {
    chosen {
        zmk,kscan = &kscan_composite;
        /* A chosen zmk,matrix-transform would make ZMK ignore the physical
         * layouts and fail the ZMK_STUDIO build assertion, so only the
         * physical layout is chosen here. */
        zmk,physical-layout = &dabao_physical_layout;
    };

    /* Auto mouse layer. Activates keymap layer 4 while the trackpoint is
     * reporting movement, and releases it 400ms after the last movement.
     * J (16) / K (17) / L (18) click, the mouse layer's left half carries the
     * trackpoint tuning keys and the speed modifiers, and the outer left thumb
     * (31) holds scroll mode, so all of those positions are excluded from
     * dismissing the layer. This matters: a key press that is not excluded
     * deactivates the layer *before* its own binding is resolved, so the binding
     * would never fire (see ZMK test
     * tests/pointing/mouse-move/processors/temp_layer/2a). Any other key press
     * still dismisses the layer. require-prior-idle-ms keeps it from coming up
     * mid-typing; set it to 0 to remove that guard.
     *
     * The positions excluded here are the ones bound on the mouse layer in
     * dabao.keymap. Adding a binding there without adding its position here
     * silently breaks it, and removing the binding without dropping the position
     * makes a plain letter key stop dismissing the layer.
     */
    auto_mouse_layer: auto_mouse_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <150>;
        excluded-positions = <0 1 2 3 4 10 11 12 13 16 17 18 30 31>;
    };

    input_listener: input_listener {
        compatible = "zmk,input-listener";
        device = <&tpoint0>;
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT &auto_mouse_layer 4 400>;

        // Layers 1 (symbols, the existing hold-TAB scroll) and 5 (scroll mode,
        // held from the outer left thumb on the mouse layer) turn trackpoint
        // motion into scrolling.
        // &zip_xy_scaler 1 5 scales both axes by 0.2 before the mapper sends X as
        // horizontal wheel and Y as vertical wheel. Previously vertical was 0.3
        // (&zip_y_scaler 3 10) and horizontal was unscaled.
        scroller {
            layers = <1 5>;
            input-processors = <&zip_xy_scaler 1 5 &zip_xy_to_scroll_mapper>;
        };

        // Layers 6 (boost, held from F on the mouse layer) and 7 (slow, held
        // from its neighbour) scale the pointer instead of redirecting it. Both
        // set process-next on purpose: an override chain replaces the base
        // chain, so without it the Y transform above would be skipped and
        // &auto_mouse_layer would stop being refreshed, letting the auto mouse
        // layer time out 400ms into a long flick and drop the held modifier.
        // Each chain holds only its scaler, so the base chain still applies its
        // transform exactly once. The scalers track remainders, so halving keeps
        // sub-unit precision instead of rounding movement away.
        //
        // Order matters, because the first matching override wins unless it sets
        // process-next: scroller is first, so holding F and boost together in
        // scroll mode gives ordinary scrolling instead of a fast diagonal. Boost
        // and slow both set process-next, so holding both composes them to 3/2.
        boost {
            layers = <6>;
            process-next;
            input-processors = <&zip_xy_scaler 3 1>;
        };

        slow {
            layers = <7>;
            process-next;
            input-processors = <&zip_xy_scaler 1 2>;
        };
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>; // 5 left + 5 right
        rows = <4>;
        map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)     RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)     RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)     RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                        RC(3,2) RC(3,3) RC(3,4)     RC(3,5) RC(3,6) RC(3,7)
        >;
    };

    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <4>;
        columns = <10>;

        kscan0: kscan_right {
            kscan = <&kscan_right>;
            col-offset = <5>;
        };
        kscan1: kscan_left {
            kscan = <&kscan_left>;
        };
    };

    /* Left Half: MCP23017 expander (columns 0-4) */
    kscan_left: kscan_left {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";

        row-gpios =
            <&left_io 8  (GPIO_ACTIVE_LOW)>,
            <&left_io 9  (GPIO_ACTIVE_LOW)>,
            <&left_io 10 (GPIO_ACTIVE_LOW)>,
            <&left_io 11 (GPIO_ACTIVE_LOW)>
        ;
        col-gpios =
            <&left_io 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&left_io 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&left_io 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&left_io 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&left_io 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
        ;
    };

    /* Right Half: Direct GPIO (columns 5-9) */
    kscan_right: kscan_right {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        row-gpios =
            <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;
        col-gpios =
            <&gpio0 9 GPIO_ACTIVE_HIGH>,
            <&gpio0 10 GPIO_ACTIVE_HIGH>,
            <&gpio1 11 GPIO_ACTIVE_HIGH>,
            <&gpio1 13 GPIO_ACTIVE_HIGH>,
            <&gpio1 15 GPIO_ACTIVE_HIGH>
        ;
    };
};

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>, <NRF_PSEL(TWIM_SCL, 0, 20)>;
            // bias-pull-up;
        };
    };
    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>, <NRF_PSEL(TWIM_SCL, 0, 20)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    compatible = "nordic,nrf-twim"; // I2C controller instead of generic
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    left_io: mcp23017@20 {
        compatible = "microchip,mcp23017";
        status = "okay";
        gpio-controller;
        reg = <0x20>;
        #gpio-cells = <2>;
        ngpios = <16>;
    };
};
